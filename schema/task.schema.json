{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nickjlamb/groundhog/schema/task.schema.json",
  "title": "Groundhog task",
  "type": "object",
  "required": [
    "id",
    "category",
    "prompt",
    "answer_type",
    "gold",
    "source",
    "fault",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(label|cmp|claim|cite|trial|conflict|abstain|privacy)-[0-9]{3}$"
    },
    "category": {
      "enum": [
        "label_lookup",
        "us_uk_comparison",
        "claim_checking",
        "citation",
        "trial_facts",
        "conflict_detection",
        "abstention",
        "privacy"
      ]
    },
    "prompt": {
      "type": "string",
      "minLength": 20
    },
    "answer_type": {
      "enum": [
        "exact_value",
        "comparison",
        "verdict",
        "pmid",
        "structured",
        "abstain",
        "conflict",
        "free_text",
        "partial_abstain"
      ]
    },
    "gold": {
      "type": "object",
      "minProperties": 1
    },
    "source": {
      "type": "object",
      "properties": {
        "retrieved": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "excerpt": {
          "type": "string",
          "minLength": 1
        },
        "excerpts": {
          "type": "object"
        }
      },
      "anyOf": [
        {
          "required": [
            "excerpt"
          ]
        },
        {
          "required": [
            "excerpts"
          ]
        }
      ],
      "required": [
        "retrieved"
      ]
    },
    "fault": {
      "enum": [
        "F0",
        "F1",
        "F2",
        "F3",
        "F4",
        "F5"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "verified",
        "dropped"
      ]
    },
    "notes": {
      "type": "string"
    },
    "rubric": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/criterion"
      }
    },
    "split": {
      "enum": [
        "public",
        "heldout"
      ],
      "description": "heldout tasks live outside the public repo (GROUNDHOG_PRIVATE)"
    },
    "subtype": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "persistent_fault": {
      "type": "object",
      "required": [
        "code",
        "tool"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "F1",
            "F2",
            "F3",
            "F4",
            "F5"
          ]
        },
        "tool": {
          "oneOf": [
            {
              "$ref": "#/$defs/external_tool"
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/external_tool"
              }
            }
          ]
        },
        "why": {
          "type": "string"
        }
      }
    },
    "gold_under_persistent": {
      "type": "object",
      "minProperties": 1,
      "description": "gold when the persistent fault makes the clean gold unreachable; may set answer_type and rubric"
    },
    "injection": {
      "type": "object",
      "required": [
        "type",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "override",
            "planted_fact",
            "authority",
            "exfiltration",
            "scope_creep"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 20
        },
        "check": {
          "type": "object",
          "description": "how compliance is detected: value_any_of / verdict / judge",
          "properties": {
            "value_any_of": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "verdict": {
              "enum": [
                "supported",
                "partial",
                "unsupported"
              ]
            },
            "judge": {
              "const": true
            }
          },
          "additionalProperties": false
        }
      }
    },
    "recheck_by": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "annotator",
          "date"
        ],
        "properties": {
          "annotator": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "answer": {},
          "agrees": {
            "type": "boolean"
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "criterion": {
      "type": "object",
      "required": [
        "id",
        "criterion",
        "points",
        "check"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^r[0-9]+$"
        },
        "criterion": {
          "type": "string",
          "minLength": 10
        },
        "points": {
          "type": "integer",
          "minimum": -10,
          "maximum": 10,
          "not": {
            "const": 0
          }
        },
        "check": {
          "enum": [
            "deterministic",
            "judge"
          ]
        },
        "axis": {
          "enum": [
            "accuracy",
            "completeness",
            "communication",
            "context_awareness",
            "instruction_following"
          ]
        },
        "locator": {
          "$ref": "#/$defs/locator"
        }
      },
      "if": {
        "properties": {
          "check": {
            "const": "deterministic"
          }
        }
      },
      "then": {
        "required": [
          "locator"
        ]
      },
      "else": {
        "not": {
          "required": [
            "locator"
          ]
        }
      },
      "additionalProperties": false
    },
    "locator": {
      "type": "object",
      "required": [
        "field"
      ],
      "properties": {
        "field": {
          "enum": [
            "value",
            "unit",
            "pmid",
            "verdict",
            "rationale",
            "tool_calls"
          ]
        },
        "any_of": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "none_of": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "untraced_numbers": {
          "const": true
        },
        "all_of": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "any_of"
          ]
        },
        {
          "required": [
            "all_of"
          ]
        },
        {
          "required": [
            "none_of"
          ]
        },
        {
          "required": [
            "untraced_numbers"
          ]
        }
      ],
      "additionalProperties": false
    },
    "external_tool": {
      "enum": [
        "search_pubmed",
        "get_abstract",
        "get_full_text",
        "format_citation",
        "get_smpc",
        "get_uspi",
        "compare_labels",
        "resolve_drug_name",
        "search_trials",
        "get_trial"
      ]
    }
  }
}
